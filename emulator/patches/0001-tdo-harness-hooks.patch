+
+/* ---- tdo harness accessors (see opera_harness.h) ---- */
+uint32_t
+opera_arm_harness_reg(int n_)
+{
+  return CPU.USER[n_ & 0xF];
+}
+
+uint32_t
+opera_arm_harness_cpsr(void)
+{
+  return CPU.CPSR;
+}
+
+void
+opera_arm_harness_set_reg(int n_, uint32_t v_)
+{
+  CPU.USER[n_ & 0xF] = v_;
+}
+
+void
+opera_arm_harness_set_cpsr(uint32_t v_)
+{
+  arm_cpsr_set(v_);   /* swaps register banks if the mode changes */
+}
+
+/* Side-effect free byte read: DRAM/VRAM and ROM only. */
+uint32_t
+opera_arm_harness_peek8(uint32_t  addr_,
+                        int      *ok_)
+{
+  uint32_t index;
+
+  *ok_ = 1;
+  if(addr_ < RAM_SIZE)
+    return opera_mem_read8(addr_);
+
+  index = (addr_ ^ 0x03000003);
+  if(!(index & ~ROM1_SIZE_MASK))
+    return ROM[index];
+
+  *ok_ = 0;
+  return 0;
+}
+
+int
+opera_arm_harness_poke8(uint32_t addr_,
+                        uint8_t  val_)
+{
+  if(addr_ >= RAM_SIZE)
+    return 0;
+  opera_mem_write8(addr_,val_);
+  return 1;
+}
